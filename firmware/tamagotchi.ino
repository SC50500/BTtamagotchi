// Playback helper
void playMelody(const int notes[], const int durations[], int length) {
  for (int i = 0; i < length; i++) {
    int noteDuration = durations[i];
    tone(BUZZER_PIN, notes[i], noteDuration);
    // pause between notes ~10% of the note's length, for separation
    int pauseBetween = noteDuration * 1.10;
    delay(pauseBetween);
    noTone(BUZZER_PIN);
  }
}

// Named functions, one per source file
void playGarageBand() {
  playMelody(GarageBand_notes, GarageBand_durations, GarageBand_length);
}

void playButterfly() {
  playMelody(Butterfly_notes, Butterfly_durations, Butterfly_length);
}

void playCrystalSnow() {
  playMelody(CrystalSnow_notes, CrystalSnow_durations, CrystalSnow_length);
}

Screen currentScreen = SCREEN_MAIN;

void setup() {
  // put your setup code here, to run once:
  pinMode(BTN_LEFTUP, INPUT_PULLUP);
  pinMode(BTN_LEFTDWN, INPUT_PULLUP);
  pinMode(BTN_RIGHTUP, INPUT_PULLUP);
  pinMode(BTN_RIGHTUP, INPUT_PULLUP);
  pinMode(SPK_SD, INPUT_PULLUP);
  pinMode(SPK_IN, OUTPUT);

  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0,0);
  display.println("Tamagotchi Init...");
  display.display();
  delay(1000);

  member.hunger = 80;
  member.happiness = 80;
  member.energy = 80;
  member.age = 0;
}

unsigned long lastUpdate = 0;

void updatePet(){
  if(millis() - lastUpdate > 5000){
    pet.hunger--;
    pet.happiness--;
    pet.energy--;
    
    if(pet.hunger < 0) pet.hunger = 0;
    if(pet.happiness < 0) pet.happiness = 0;
    if(pet.energy < 0) pet.energy = 0;
    
    pet.age +=== 5;
    lastUpdate = millis();
  }
}

unsigned long lastButtonPress = 0;
int 

void checkButtons(){
  if(millis() - lastButtonPress < 200) return;
  
  if(digitalRead(BTN_LEFTUP) == LOW){
    currentScreen = SCREEN_FEED;
    tone(SPK_IN, 1000, 50);
    lastButtonPress = millis();
  }
  else if(digitalRead(BTN_LEFTDWN) == LOW){
    currentScreen = SCREEN_PLAY;
    tone(SPK_IN, 1000, 50);
    lastButtonPress = millis();
  }
  else if(digitalRead(BTN_RIGHTUP) == LOW){
    currentScreen = SCREEN_SLEEP;
    tone(SPK_IN, 1000, 50);
    lastButtonPress = millis();
  }
  else(digitalRead(BTN_RIGHTDWN) == LOW){
    currentScreen = SCREEN_MUSIC;
    tone(SPK_IN, 1000, 50);
    lastButtonPress = millis();
  }
}

void handleScreenLogic(){
  switch(currentScreen){
    case SCREEN_FEED:
      pet.hunger += 10;
      if(pet.hunger > 100) pet.hunger = 100;
      currentScreen = SCREEN_MAIN;
      break;
    
    case SCREEN_PLAY:
      pet.happiness += 10;
      pet.energy -= 5;
      if(pet.happiness > 100) pet.happiness = 100;
      if(pet.energy < 0) pet.energy = 0;
      currentScreen = SCREEN_MAIN;
      break;

    case SCREEN_SLEEP:
      pet.energy += 5;
      if(pet.energy > 100) pet.energy = 100;
      currentScreen = SCREEN_MAIN;
      break;

    case SCREEN_MUSIC:
      pet.happiness += 5;
      pet.energy -= 2;
      if(pet.happiness > 100) pet.happiness = 100;
      if(pet.energy < 0) pet.energy = 0;
      currentScreen = SCREEN_MAIN;
      playGarageBand();
      playButterfly();
      playCrystalSnow();
      break;
    
    case SCREEN_MAIN:
      break;
  }
}

